{
  "expo": {
    "name": "Magic Cuts",
    "slug": "magic-cuts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0ECE4"
      },
      "package": "com.magiccuts.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Приложението използва камерата, за да снимаш желаната прическа.",
          "photosPermission": "Приложението използва снимките ти, за да прикачиш желаната прическа.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F0ECE4"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1b5884f-199a-4d7b-ac28-648330b87220"
      }
    },
    "owner": "simeon_enev"
  }
}
